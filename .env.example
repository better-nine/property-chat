# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Primary / fallback provider: anthropic | openai | ollama
LLM_PRIMARY=anthropic
LLM_FALLBACK=openai

# Ollama (local, optional)
OLLAMA_BASE_URL=http://localhost:11434

# Database (PostgreSQL + pgvector)
DB_URL=jdbc:postgresql://localhost:5432/property_chat
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 공공데이터포털 (국토교통부 실거래가)
DATA_GO_KR_SERVICE_KEY=
# 국가법령정보센터 Open API
LAW_GO_KR_OC=

# Observability (Langfuse via OpenTelemetry)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Limits
DAILY_COST_LIMIT_KRW=5000
