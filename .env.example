# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Active provider: openai | anthropic | gemini | ollama | bedrock
LLM_PROVIDER=anthropic
LLM_MODEL=
FALLBACK_PROVIDERS=openai,gemini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_chat

# Public data
# 공공데이터포털 (국토교통부 실거래가)
DATA_GO_KR_SERVICE_KEY=
# 국가법령정보센터 Open API
LAW_GO_KR_OC=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=

# Limits
DAILY_COST_LIMIT_KRW=5000
